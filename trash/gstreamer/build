#!/bin/sh -e

meson setup build       \
    --prefix=/usr       \
    --buildtype=release \
    -D gst_debug=false

meson compile -C build
meson install -C build --destdir=$1

if [ "$MULTILIB" = "1" ]; then
#32bit split package
rm -rf build
meson setup build       \
    --prefix=/usr       \
    --libdir=/usr/lib32 \
    --cross-file=lib32  \
    --buildtype=release \
    -D gst-plugins-good:lame=disabled \
    -D gst_debug=false

meson compile -C build
meson install -C build --destdir=$PWD/DESTDIR
dest_dir="$HOKUTO_SPLIT_DIR/lib32-$3"
install -d $dest_dir/usr/lib32
cp -vR DESTDIR/usr/lib32/* $dest_dir/usr/lib32
fi
